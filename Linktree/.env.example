# Browser bundle (injected at build time by Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server functions (read from the server environment)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional — enables click analytics and quiz vote recording when
# self-hosting outside Lovable Cloud. Never expose this to the browser.
# SUPABASE_SERVICE_ROLE_KEY=

# Tooling — used only by drizzle-kit for migrations
# LOVABLE_DB_MIGRATION_URL=
